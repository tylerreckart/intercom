{
  "listen_host": "0.0.0.0",
  "listen_port": 8090,
  "device_token": "dev-device-secret-change-me",
  "devices": {},
  "arbiter_base_url": "http://127.0.0.1:8080",
  "arbiter_token": "atr_REPLACE_ME",
  "agent": "index",
  "session_db": "~/.alfred/sessions.db",
  "sample_rate": 16000,
  "channels": 1,
  "fast_path": true,
  "whisper": {
    "binary": "whisper-cli",
    "model": "~/.alfred/models/ggml-base.en.bin",
    "timeout_seconds": 120,
    "language": "en"
  },
  "piper": {
    "binary": "piper",
    "model": "~/.alfred/models/en_US-lessac-medium.onnx",
    "timeout_seconds": 60,
    "native_sample_rate": 22050
  }
}
