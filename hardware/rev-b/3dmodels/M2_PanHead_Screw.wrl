#VRML V2.0 utf8
# Visual stand-in: M2 pan-head screw at a plated mounting hole. Origin at hole center.
WorldInfo { title "M2 pan-head screw" }
Transform {
  children [
    Transform {
      translation 0 0 0.8
      children Shape {
        appearance Appearance {
          material Material {
            diffuseColor 0.62 0.62 0.65
            specularColor 0.4 0.4 0.4
            shininess 0.5
          }
        }
        geometry Box { size 4.0 4.0 1.6 }
      }
    }
    Transform {
      translation 0 0 -0.6
      children Shape {
        appearance Appearance {
          material Material { diffuseColor 0.55 0.55 0.58 }
        }
        geometry Box { size 1.9 1.9 1.2 }
      }
    }
  ]
}
