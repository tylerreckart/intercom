(version 1)
(rule "0201 assembly clearance"
  (constraint clearance (min 0.15mm))
  (condition "A.memberOfFootprint('Resistor_SMD:R_0201_0603Metric') || B.memberOfFootprint('Resistor_SMD:R_0201_0603Metric') || A.memberOfFootprint('Capacitor_SMD:C_0201_0603Metric') || B.memberOfFootprint('Capacitor_SMD:C_0201_0603Metric')")
)

(rule "USB-C fine-pitch breakout width"
  (constraint track_width (min 0.15mm))
  (condition "A.NetName == 'USB_DN' || A.NetName == 'USB_DP'")
)

(rule "USB-C fine-pitch breakout clearance"
  (constraint clearance (min 0.14mm))
  (condition "(A.NetName == 'USB_DN' && B.NetName == 'CC1') || (A.NetName == 'CC1' && B.NetName == 'USB_DN')")
)
